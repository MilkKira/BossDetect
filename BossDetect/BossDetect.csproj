<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<Nullable>disable</Nullable>
		<LangVersion>latest</LangVersion>
		<AssemblyName>BossDetect</AssemblyName>
		<RootNamespace>BossDetect</RootNamespace>
		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<Authors>Mochix2Milk</Authors>
		<Company>Mochix2Milk</Company>
		<Product>Boss Detect</Product>
		<Description>Client-side boss detection with in-game notifications gated by Hideout Intelligence Center level.</Description>

		<!-- 修改这里指向你的 SPT 客户端根目录 -->
		<GameRoot>D:\BaiduSyncdisk\EscapeFromTarkovFiles</GameRoot>
		<OutDir>$(GameRoot)\BepInEx\plugins\BossDetect\</OutDir>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="BepInEx">
			<HintPath>$(GameRoot)\BepInEx\core\BepInEx.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Comfort">
			<HintPath>$(GameRoot)\EscapeFromTarkov_Data\Managed\Comfort.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(GameRoot)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(GameRoot)\EscapeFromTarkov_Data\Managed\UnityEngine*.dll">
			<Private>False</Private>
		</Reference>
	</ItemGroup>

</Project>
